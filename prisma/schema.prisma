generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id           String          @id @default(uuid())
  titulo       String
  descripcion  String?
  ubicacion    String
  imagenUrl    String?
  fecha        DateTime?
  fechaFin     DateTime?
  precio       Int             @default(0)
  precioEstado String          @default("NO_INFORMADO")
  fuenteNombre String?
  fuenteUrl    String?
  externalKey  String?
  destacado    Boolean         @default(false)
  creadoPor    String?
  creadoEl     DateTime        @default(now())
  tags         IdeaTag[]
  realizados   PlanRealizado[]
  sugerencia   PlanSuggestion?

  @@index([fecha])
  @@index([fechaFin])
  @@index([externalKey])
}

model Tag {
  id     String    @id @default(uuid())
  nombre String    @unique
  ideas  IdeaTag[]
}

model IdeaTag {
  ideaId String
  tagId  String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
}

model PlanRealizado {
  id        String   @id @default(uuid())
  userId    String
  ideaId    String?
  titulo    String
  ubicacion String
  fecha     DateTime
  foto      String?
  nota      String?
  creadoEl  DateTime @default(now())
  idea      Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@unique([userId, ideaId])
  @@index([userId, fecha])
}

model AIUsageLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model DiscoverySource {
  id              String    @id
  nombre          String
  url             String
  tipo            String
  habilitada      Boolean   @default(true)
  ultimaEjecucion DateTime?
  ultimoEstado    String?
  ultimoError     String?
  creadoEl        DateTime  @default(now())
  actualizadoEl   DateTime  @updatedAt
}

model PlanSuggestion {
  id            String    @id @default(uuid())
  fingerprint   String    @unique
  titulo        String
  descripcion   String?
  ubicacion     String
  fecha         DateTime
  fechaFin      DateTime?
  precio        Int       @default(0)
  precioEstado  String    @default("NO_INFORMADO")
  imagenUrl     String?
  fuenteId      String
  fuenteNombre  String
  fuenteUrl     String
  tags          String[]  @default([])
  estado        String    @default("PENDIENTE")
  confianza     Int       @default(50)
  advertencias  String?
  descubiertoEl DateTime  @default(now())
  actualizadoEl DateTime  @updatedAt
  ideaId        String?   @unique
  idea          Idea?     @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([estado, fecha])
  @@index([fuenteId])
}
