{
  "manifest_version": 3,
  "name": "Que Hacer Santiago - Recolector local",
  "description": "Consulta carteleras desde tu navegador y entrega las sugerencias al panel de administración sin usar Railway.",
  "version": "1.3.0",
  "permissions": [],
  "host_permissions": [
    "https://*.bibliotecasantiago.gob.cl/*",
    "https://*.bibliotecanacional.gob.cl/*",
    "https://*.providencia.cl/*",
    "https://*.visitsantiago.travel/*",
    "https://*.cclm.cl/*",
    "https://*.gam.cl/*",
    "https://*.latercera.com/*",
    "https://*.camaradellibro.cl/*",
    "https://*.hoyjugue.cl/*",
    "https://*.mesa1.cl/*",
    "https://*.bastiongoblin.com/*",
    "https://*.area52.cl/*",
    "https://*.cartasmagicsur.cl/*",
    "https://*.torneostcg.cl/*",
    "https://*.eventhoy.com/*",
    "https://*.deckshield.cl/*",
    "https://*.iicsantiago.esteri.it/*",
    "https://*.m100.cl/*",
    "https://*.mnba.gob.cl/*",
    "https://*.mac.uchile.cl/*",
    "https://*.ceina.cl/*",
    "https://*.culturallascondes.cl/*",
    "https://*.munistgo.cl/*",
    "https://*.portaldisc.com/*",
    "https://*.ccn.cl/*",
    "https://*.mallplaza.com/*",
    "https://*.factoria-franklin.cl/*",
    "https://*.mavi.uc.cl/*",
    "https://*.barriolastarria.cl/*",
    "https://*.clubchocolate.cl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://quehacer-santiago.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.up.railway.app/*"
      ],
      "js": ["discovery.js", "content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Que Hacer Santiago - Recolector local"
  }
}
